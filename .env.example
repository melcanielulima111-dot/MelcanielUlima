# ===================================================================
# CalFéx Pro — Exemplo de Configuração de Variáveis de Ambiente (.env)
# ===================================================================

# 1. GOOGLE GEMINI AI (Obrigatório para o Mentor IA com Áudio e Texto)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. E-MAIL DE NOTIFICAÇÃO E RECUPERAÇÃO DE SENHA
# E-mail remetente oficial do CalFéx
CALFEX_SENDER_EMAIL=calfex39@gmail.com

# Senha de Aplicativo de 16 caracteres gerada na Conta Google do remetente
# (Acesse: Conta Google > Segurança > Verificação em duas etapas > Senhas de app)
GMAIL_APP_PASSWORD=

# 3. CONFIGURAÇÕES OPCIONAIS DE SERVIDOR
# Porta local para execução com Node.js (Padrão: 3000)
PORT=3000

# Caminho personalizado para persistência de banco de dados (Opcional)
# DB_FILE_PATH=/caminho/para/calfex_cloud_db.json
