# ===================================================================
# Calféx — Exemplo de Configuração de Variáveis de Ambiente (.env)
# ===================================================================

# 1. SUPABASE CLOUD DATABASE (Banco de Dados Permanente na Nuvem)
# Obtenha o URL e as chaves em: https://supabase.com > Seu Projeto > Project Settings > API
SUPABASE_URL=
# Use a Anon Key ou Service Role Key do Supabase:
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. GOOGLE GEMINI AI (Obrigatório para o Mentor IA com Áudio e Texto)
# Obtenha sua chave gratuita em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 3. E-MAIL DE NOTIFICAÇÃO E RECUPERAÇÃO DE SENHA
# E-mail remetente oficial do CalFéx
CALFEX_SENDER_EMAIL=calfex39@gmail.com

# Senha de Aplicativo de 16 caracteres gerada na Conta Google do remetente
# (Acesse: Conta Google > Segurança > Verificação em duas etapas > Senhas de app)
GMAIL_APP_PASSWORD=

# 4. CONFIGURAÇÕES OPCIONAIS DO FRONTEND E SERVIDOR
# URL do backend se hospedado separadamente do frontend (Deixe vazio no Netlify)
VITE_API_URL=
PORT=3000
